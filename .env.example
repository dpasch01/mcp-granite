# Optional provider credentials. Export the credentials for your chosen provider
# in your shell before running; no API key is needed for local Ollama models.
# export OPENAI_API_KEY=...
# export ANTHROPIC_API_KEY=...
# export GOOGLE_API_KEY=...

# Optional monitoring endpoint (requires a running Prometheus instance).
# ETB_PROMETHEUS_URL=http://localhost:9090

# Optional external dataset path; the value must point to domain subdirectories.
# Set scenarios_dir in the experiment YAML when that config already defines it.
# ETB_SCENARIOS_DIR=../mcp-granite-dataset/scenarios
